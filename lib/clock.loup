@mode(host.dual)

# UTC time stamps from seconds since 1970: the date of a live run (the
# report's date line, a recording's recorded_at).
#
# Runtime: host.dual, but only ever interpreted here: bin/fleet-audit.lpscr
# imports it under `loup run`, and `make test` loads it into the unit tests
# under Stage0 (`loup-bootstrap test`). Being host.dual keeps it compilable:
# core.datetime works in every hosted lane.

from core.datetime import (DateTime);

# `2026-10-20 07:50 UTC`: the ISO date, then the hours and minutes of the
# ISO time (`07:50:12`); the calendar arithmetic is core.datetime's.
pub func utc_stamp(epoch_seconds: int): string {
    let t = DateTime.utcFromTimestamp(epoch_seconds as float);
    return t.date().isoformat() + " " + t.time().isoformat().slice(0, 5) + " UTC";
}
