@mode(host.dual)

# Reads the facts the audit needs out of a checked-out repository (a clone,
# or a recorded tree under tests/fixtures).
#
# Runtime: host.dual, but only ever interpreted here: bin/fleet-audit.lpscr
# imports it under `loup run`, and `make test` loads it into the unit tests
# under Stage0 (`loup-bootstrap test`). It is not compilable: native builds
# of Loup 1.26.0 have no `set`, which both interpreters run.
#
# Structure: read_tree looks at the manifest, the CI workflow, the program
# sources (for APP_VERSION), the todo file, a license, the specs and the
# README, in that order. Every file that supplies a fact goes into
# TreeFacts.files: that list is what `--record` copies, so a recording
# holds exactly the files that the same audit needs on replay.

from io.fs import (walk, isDir, isFile, listDir);
from io.path import (extname);
from .facts import (TreeFacts, toml_value, ci_loup_version, app_version, readme_section);

pub const MANIFEST: string = "package.lppkg";
pub const WORKFLOW: string = ".github/workflows/ci.yml";
pub const TODOS: string = "REPOSITORY_TODOS.md";
pub const README: string = "README.md";
# The template's own sample spec, which a repository replaces.
pub const TEMPLATE_SPEC: string = "command-line-interface";

let SOURCE_EXTENSIONS: set[string] = {".loup", ".lpscr", ".lphc", ".lpfree"};
let LICENSE_NAMES: list[string] = ["LICENSE", "LICENSE.md", "LICENSE.txt", "COPYING"];
let SPEC_FILES: list[string] = ["requirements.md", "design.md", "tasks.md"];

func at(dir: string, rel: string): string {
    return dir + "/" + rel;
}

# Whether a relative path is program source the audit should search for
# APP_VERSION (not the skill's examples, the tests or git's own files).
func is_source(rel: string): bool {
    if (rel.startsWith(".git/") or rel.startsWith("skills/") or rel.startsWith("tests/")) {
        return false;
    }
    return SOURCE_EXTENSIONS.contains(extname(rel));
}

pub func read_tree(dir: string): TreeFacts {
    var files: list[string] = [];

    let manifest_found = isFile(at(dir, MANIFEST));
    var manifest_text = "";
    if (manifest_found) {
        manifest_text = readText(at(dir, MANIFEST));
        files.push(MANIFEST);
    }

    let ci_found = isFile(at(dir, WORKFLOW));
    var ci_loup = "";
    if (ci_found) {
        ci_loup = ci_loup_version(readText(at(dir, WORKFLOW)));
        files.push(WORKFLOW);
    }

    # The first program source in walk order that defines the version.
    var found_version = "";
    var version_file = "";
    for (rel in walk(dir)) {
        if (is_source(rel)) {
            let value = app_version(readText(at(dir, rel)));
            if (value.len() > 0) {
                found_version = value;
                version_file = rel;
                files.push(rel);
                break;
            }
        }
    }

    let has_todos = isFile(at(dir, TODOS));
    if (has_todos) {
        files.push(TODOS);
    }
    var has_license = false;
    for (name in LICENSE_NAMES) {
        if (!has_license and isFile(at(dir, name))) {
            has_license = true;
            files.push(name);
        }
    }

    # A spec counts when its directory holds all three files; the template's
    # sample spec never counts. Names are sorted: listDir's order is the OS's.
    # A missing file moves on to the next directory (`continue candidates`).
    var specs: list[string] = [];
    if (isDir(at(dir, "specs"))) {
        var names = listDir(at(dir, "specs"));
        names.sort(func(a: string, b: string): int { return if (a < b) { -1 } else if (a > b) { 1 } else { 0 }; });
        candidates: for (name in names) {
            if (name == TEMPLATE_SPEC or !isDir(at(dir, "specs/" + name))) {
                continue;
            }
            for (file in SPEC_FILES) {
                if (!isFile(at(dir, "specs/" + name + "/" + file))) {
                    continue candidates;
                }
            }
            specs.push(name);
            for (file in SPEC_FILES) {
                files.push("specs/" + name + "/" + file);
            }
        }
    }

    let readme_found = isFile(at(dir, README));
    var section = "";
    if (readme_found) {
        section = readme_section(readText(at(dir, README)));
        files.push(README);
    }

    return TreeFacts(
        manifest_found = manifest_found,
        manifest_loup = toml_value(manifest_text, "loup"),
        manifest_version = toml_value(manifest_text, "version"),
        ci_found = ci_found,
        ci_loup = ci_loup,
        app_version = found_version,
        app_version_file = version_file,
        has_todos = has_todos,
        has_license = has_license,
        specs = specs,
        readme_found = readme_found,
        readme_section = section,
        files = files,
    );
}
