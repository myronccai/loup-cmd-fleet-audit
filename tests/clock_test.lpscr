@mode(host.scripted)

# Unit tests for the UTC time stamps (lib/clock.loup): the epoch, a recent
# date and a leap day.
#
# Runtime: host.scripted, run by the test runner: `make test` interprets this
# file with Stage0 (`loup-bootstrap test --no-parallel --file
# tests/clock_test.lpscr`), one test per `func test_*()`, importing lib/ with
# relative imports. It is not part of the program. It needs no files and no
# network.

from debug.assert import (expectEq);
from ..lib.clock import (utc_stamp);

func test_utc_stamp(): void {
    expectEq(utc_stamp(0), "1970-01-01 00:00 UTC", "epoch");
    expectEq(utc_stamp(1792480092), "2026-10-20 07:08 UTC", "2026");
    expectEq(utc_stamp(951782400), "2000-02-29 00:00 UTC", "leap day");
}
