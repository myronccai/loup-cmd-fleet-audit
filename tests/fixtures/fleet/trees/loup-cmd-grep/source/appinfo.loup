@mode(host.dual)

# Fixture: loup-cmd-grep's source/appinfo.loup as recorded in
# tests/fixtures/fleet, one of the files the audit reads from a repository.
# Edited for the tests: its version, 0.2.0, differs from package.lppkg, so the
# `version` check fails.
#
# Runtime: host.dual, as in loup-cmd-grep, but never compiled or run here:
# lib/tree.loup reads it as text to find the APP_VERSION constant, which the
# `version` check compares with the version in the package.lppkg beside it.
# The original file's own comments follow.
#
# Application identity. Keep APP_NAME and APP_VERSION in step with `name`
# and `version` in package.lppkg.

pub const APP_NAME: string = "grep";
pub const APP_VERSION: string = "0.2.0";
pub const APP_SUMMARY: string = "Print lines that match patterns (a Loup recreation of GNU grep).";

# Exit statuses returned by main(), as in GNU grep.
pub const EXIT_OK: int = 0;        # a line was selected
pub const EXIT_NO_MATCH: int = 1;  # no line was selected
pub const EXIT_TROUBLE: int = 2;   # usage error, bad pattern or unreadable input
