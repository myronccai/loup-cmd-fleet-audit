@mode(host.dual)

# Fixture: loup-cmd-ls's source/appinfo.loup as recorded in
# tests/fixtures/fleet, one of the files the audit reads from a repository.
#
# Runtime: host.dual, as in loup-cmd-ls, but never compiled or run here:
# lib/tree.loup reads it as text to find the APP_VERSION constant, which the
# `version` check compares with the version in the package.lppkg beside it.
# The original file's own comments follow.
#
# Application identity. Keep APP_NAME and APP_VERSION in step with `name`
# and `version` in package.lppkg.

pub const APP_NAME: string = "ls";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "List directory contents (a Loup recreation of GNU ls).";

# Exit statuses returned by main(), as GNU ls uses them.
pub const EXIT_OK: int = 0;
# Minor problems, e.g. a subdirectory that cannot be listed; also a bad
# --classify argument.
pub const EXIT_FAILURE: int = 1;
# Serious trouble: a command-line operand that cannot be accessed, or a usage
# error.
pub const EXIT_TROUBLE: int = 2;
pub const EXIT_USAGE: int = 2;
