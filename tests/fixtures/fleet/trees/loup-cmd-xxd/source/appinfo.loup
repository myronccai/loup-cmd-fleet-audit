@mode(host.dual)

# Fixture: loup-cmd-xxd's source/appinfo.loup as recorded in
# tests/fixtures/fleet, one of the files the audit reads from a repository.
#
# Runtime: host.dual, as in loup-cmd-xxd, but never compiled or run here:
# lib/tree.loup reads it as text to find the APP_VERSION constant, which the
# `version` check compares with the version in the package.lppkg beside it.
# The original file's own comments follow.
#
# Application identity. Keep APP_NAME and APP_VERSION in step with `name`
# and `version` in package.lppkg.

pub const APP_NAME: string = "xxd";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Make a hex dump or reverse one (a Loup recreation of xxd).";

# Exit statuses returned by main(), as xxd uses them.
pub const EXIT_OK: int = 0;
pub const EXIT_USAGE: int = 1;          # bad options or columns
pub const EXIT_INPUT: int = 2;          # cannot open the input file
pub const EXIT_OUTPUT: int = 3;         # cannot open the output file
pub const EXIT_SEEK: int = 4;           # -s points before the start of the input
pub const EXIT_SEEK_BACK: int = 5;      # -r would have to write backwards into a pipe
pub const EXIT_CANNOT_REVERT: int = 255; # -r with -i (or -b)
